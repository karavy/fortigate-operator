# 1. DICHIARAZIONE: Diciamo a Terraform cosa scaricare e da dove
terraform {
  required_providers {
    fortios = {
      source  = "fortinetdev/fortios"
      version = "1.25.0"
    }
  }
  backend "s3" {
    bucket = "<FGT_S3STATE_BUCKET>"
    key = "<FGT_S3STATE_KEY>"
    region = "<FGT_S3STATE_REGION>"
    endpoints = {
      s3 = "<FGT_S3STATE_ENDPOINT>"
    }
    use_path_style = true
		skip_credentials_validation = true
		skip_metadata_api_check = true
		skip_region_validation = true
		skip_requesting_account_id = true
  }
}

# 2. CONFIGURAZIONE: Inseriamo le credenziali di accesso al firewall
provider "fortios" {
  hostname = "<FGT_IP_OR_NAME>"
  token    = "<FGT_API_TOKEN>"
  insecure = true # Ignora i certificati SSL self-signed del firewall
}