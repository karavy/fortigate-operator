resource "fortios_system_global" "global" {
  hostname                       = "<FGT_HOSTNAME>"
  alias                          = "<FGT_ALIAS>"
  admin_sport                    = <FGT_ADMINSPORT>
  timezone                       = "<FGT_TIMEZONE>"
  gui_auto_upgrade_setup_warning = "disable"
  gui_firmware_upgrade_warning   = "disable"
}

<FGT_FOR_STR><EXTRAPARAMS_ACCPROFILES>
resource "fortios_system_accprofile" "<EXTRAPARAMS_ACCPROFILES_NAME>" {
  name       = "<EXTRAPARAMS_ACCPROFILES_NAME>"
  secfabgrp  = "read-write"
  ftviewgrp  = "read-write"
  authgrp    = "read-write"
  sysgrp     = "read-write"
  netgrp     = "read-write"
  loggrp     = "read-write"
  fwgrp      = "read-write"
  vpngrp     = "read-write"
  utmgrp     = "read-write"
  wanoptgrp  = "read-write"
  wifi       = "read-write"
  cli_get    = "enable"
  cli_show   = "enable"
  cli_exec   = "enable"
  cli_config = "<EXTRAPARAMS_ACCPROFILES_CLICONFIG>"
}
<FGT_FOR_END>

resource "fortios_system_passwordpolicy" "password_policy" {
  status = "disable"
}

resource "fortios_system_dns" "dns" {
  primary   = "<FGT_DNSPRIMARY>"
  secondary = "<FGT_DNSSECONDARY>"
}

resource "fortios_system_ntp" "ntp" {
  ntpsync     = "enable"
  server_mode = "enable"

  interface {
    interface_name = "<FGT_NTPINTERFACE>"
  }
}

resource "fortios_system_emailserver" "email_server" {
  server   = "<FGT_EMAILSERVER>"
  port     = <FGT_EMAILPORT>
  security = "smtps"
}

resource "fortios_systemautoupdate_schedule" "autoupdate_schedule" {
  frequency = "daily"
  time      = "01:24"
  status    = "disable"
}

resource "fortios_system_fortiguard" "fortiguard" {
  update_server_location        = "<FGT_FORTIGUARDLOCATION>"
  auto_firmware_upgrade         = "disable"
  antispam_timeout              = 30
  outbreak_prevention_timeout   = 30
  webfilter_timeout             = 30

}

resource "fortios_system_resourcelimits" "resource_limits" {
  log_disk_quota = <FGT_LOGDISKQUOTA>
}

<FGT_FOR_STR><EXTRAPARAMS_STORAGEDISKS>
resource "fortios_system_storage" "<EXTRAPARAMS_STORAGEDISKS_NAME>" {
  name         = "<EXTRAPARAMS_STORAGEDISKS_NAME>"
  status       = "enable"
  media_status = "enable"
  order        = 1
  partition    = "<EXTRAPARAMS_STORAGEDISKS_PARTITION>"
  device       = "<EXTRAPARAMS_STORAGEDISKS_DEVICE>"
  size         = <EXTRAPARAMS_STORAGEDISKS_SIZE>
  usage        = "log"
}
<FGT_FOR_END>